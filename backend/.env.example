PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/blog-platform
JWT_SECRET=

# Optional Cloudinary configs (if left blank, uploads fall back to local server folder `/uploads`)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional CORS lock-down origin (defaults to * if left empty)
FRONTEND_URL=http://localhost:3000

# Mail Configuration (SMTP Credentials)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
